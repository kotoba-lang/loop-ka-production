;; The -ka channels this loop orchestrates.
;;
;; One entry per publishing channel. The loop does NOT know how to produce a
;; video — each channel names the command that does, in its own repo. That is
;; deliberate: production logic belongs to the -ka repo that owns the craft, and
;; this loop owns cadence, admission and evidence.
;;
;; :id            stable key used in ledger records and task labels
;; :repo          workspace-relative checkout the producer runs in
;; :producer      argv template; %s substitutions documented per :produces
;; :produces      :episode-from-catalog — picks the next unconsumed catalog entry
;;                :episode-from-topic   — needs a topic supplied per run
;; :catalog       dir of plan files, when :produces is :episode-from-catalog
;; :actor         aozora handle the channel publishes under (evidence only —
;;                the publish leg lives in the channel's own repo, with its own
;;                key; this loop never holds a publishing key)
;; :slots         how many concurrent runs this channel tolerates on one node
;; :requires      capabilities a node must have to run it (murakumo placement)
{:channels/version 1
 :channels
 [{:id :dougaka
   :repo "orgs/cloud-itonami/dougaka-actor"
   :producer ["clojure" "-M:dev" "-m" "dougaka.outer-loop"]
   :produces :episode-from-catalog
   :catalog "videos"
   :actor "dougaka.aozora.app"
   :slots 1
   :requires #{:ffmpeg :clojure}}

  {:id :minidrama
   :repo "orgs/etzhayyim/com-etzhayyim-minidrama"
   :producer ["clojure" "-M:dev" "-m" "minidrama.outer-loop"]
   :produces :episode-from-catalog
   :catalog "episodes"
   :actor "minidrama.aozora.app"
   :slots 1
   :requires #{:ffmpeg :clojure}}

  {:id :dougaka-vector
   :repo "orgs/cloud-itonami/dougaka-vector"
   :producer ["nbb" "--classpath" "src" "bin/render.cljs"]
   :produces :episode-from-topic
   :actor "dougaka-vector.aozora.app"
   :slots 2
   :requires #{:ffmpeg :nbb}}

  ;; yukkuri has no episode catalog yet. Registering `content/` as one was wrong
  ;; and immediately visible: that dir holds topic corpora (anime.edn,
  ;; cyber-cisa-yougo.edn) and md-as-edn docs, so the first plan selected
  ;; "README.md" as tonight's episode. A catalog is a running order of episode
  ;; plans, not whatever .edn files a directory happens to contain.
  {:id :yukkuri
   :repo "orgs/cloud-itonami/yukkuri"
   :producer ["nbb" "--classpath" "clj/src" "scripts/publish_aozora.cljs"]
   :produces :episode-from-topic
   :actor "yukkuri.aozora.app"
   :slots 1
   :requires #{:ffmpeg :nbb}}

  ;; SHIRO & PICO (the GHOSTHACKER series). Not a `-ka` repo, and registered
  ;; here anyway: the five verbs this loop owns — cadence, admission, verdict,
  ;; evidence — are the same ones a dedicated `loop-shiropico` would have had to
  ;; reimplement, and this repo exists precisely because every channel used to
  ;; carry its own copy. See ADR-2607309900.
  ;;
  ;; :catalog is `production-catalog`, NOT the repo's existing `catalog/` — that
  ;; one holds ai-gftd-datasets.json and would list zero .edn files, reading as
  ;; an exhausted catalog rather than a misconfiguration. Same trap as yukkuri's
  ;; `content/` above.
  ;;
  ;; Only episodes 11 and 12 are in the catalog. Episodes 1-10 have scripts but
  ;; no shotlist, so the producer has nothing to render for them; listing them
  ;; would have this loop admit work it then grades.
  ;;
  ;; The producer reports :placeholder/:silent legs when no render backend is
  ;; reachable, so a node without one produces a :degraded verdict and a hold —
  ;; not a published flat card.
  {:id :shiropico
   :repo "orgs/com-junkawasaki/ghosthacker-shiropico"
   ;; comfyui.native-client (kotoba-lang/comfyui) is on the classpath rather
   ;; than copied into the content repo. The path is relative because the
   ;; producer runs with cwd = <workspace>/<repo>.
   :producer ["nbb" "--classpath" "src:../../kotoba-lang/comfyui/src" "bin/produce.cljs"]
   :produces :episode-from-catalog
   :catalog "production-catalog"
   ;; Evidence only — the publish leg lives in that repo's own `clj/` actor
   ;; (advisor ⊣ PolicyGovernor ⊣ ledger) with its own key. This loop holds none.
   :actor "shiropico.aozora.app"
   :slots 1
   ;; :requires has no :ffmpeg. Measured 2026-08-14: bin/produce.cljs writes
   ;; PNGs (ComfyUI) and WAVs (kokoro) and stops — there is no mux, concat or
   ;; mp4 anywhere in it. The 26s ep01 motion comic in B2 came from an earlier
   ;; Seedance path, not from this producer.
   ;;
   ;; Requiring a capability the producer never calls does not fail loudly — it
   ;; makes the placer skip nodes that could have run the job, which is the trap
   ;; the :ghosthacker entry below names. Add :ffmpeg back together with a mux
   ;; step, not in anticipation of one.
   :requires #{:nbb}}

  ;; GHOST HACKER — the series itself, as manga. Registered on the same grounds
  ;; as :shiropico (ADR-2607309900): the five verbs are this repo's, not each
  ;; channel's. The 2026-06 note calling this series superseded by
  ;; kami-engine/kami-app-sip-clj was retracted 2026-07-30 — that path holds
  ;; .shadow-cljs/ and public/ and nothing else, and kami-engine contains zero
  ;; references to the series.
  ;;
  ;; The unit is one episode = one directory under
  ;; 260123-jump/resources/episodes/. Six are in the catalog;
  ;; ep1-komawari-redesign is not, because it has no episode id and zero panels.
  ;;
  ;; :requires has no :ffmpeg. This is manga — panels get images, nothing gets
  ;; muxed. Copying the video channels' requirement would have the placer demand
  ;; a capability the work never uses and skip nodes that could run it.
  ;;
  ;; The producer reports :video per panel and :voice [] — a manga has no
  ;; narration leg, and an empty voice list is not graded degraded. See that
  ;; repo's PRODUCING.md.
  ;; gameka — games, not video. Registered on the same grounds as :shiropico
  ;; and :ghosthacker: the five verbs are this repo's, not each channel's.
  ;;
  ;; :catalog is `specs`, the gameSpec running order. A build is one spec.
  ;;
  ;; :requires has no :ffmpeg. Nothing is muxed — the producer renders runtime
  ;; sources and per-cue audio, and the runtime assembles at play time.
  ;;
  ;; Leg vocabulary, following the :ghosthacker precedent below: the producer
  ;; reports :video per generated **audio cue** (:murakumo when the fleet
  ;; rendered it, :placeholder when it fell back) and :voice [] — a game has no
  ;; narration, and an empty voice list is not graded degraded. The keys are
  ;; video-shaped because the first four channels were video; what is graded is
  ;; "did the generative legs run", which is the same question either way.
  ;;
  ;; A game with silent weapons is not a release: the weapon cue is the only
  ;; feedback that auto-fire is working and the boss telegraph is the only
  ;; warning a dodgeable attack is coming, so a placeholder cue set grades
  ;; :degraded and holds, exactly like a flat-colour card.
  {:id :gameka
   :repo "orgs/cloud-itonami/gameka"
   :producer ["clojure" "-M:produce"]
   :produces :episode-from-catalog
   :catalog "specs"
   :actor "gameka.aozora.app"
   :slots 1
   :requires #{:clojure}}

  {:id :ghosthacker
   :repo "orgs/com-junkawasaki/ghosthacker"
   :producer ["nbb" "--classpath" "src:../../kotoba-lang/comfyui/src" "scripts/produce.cljs"]
   :produces :episode-from-catalog
   :catalog "production-catalog"
   :actor "ghosthacker.aozora.app"
   :slots 1
   :requires #{:nbb}}]}
